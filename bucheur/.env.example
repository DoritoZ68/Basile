# Clés publiques RevenueCat (Project settings › API keys). Copie ce fichier en .env.local.
# Sans clé, les achats sont simulés en développement (Expo Go) et indisponibles en production.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxx
