# Copie ce fichier en .env.local et remplis les valeurs dont tu as besoin.

# Version web : vente de Bûcheur Pro sur Gumroad (voir README › Publier gratuitement).
EXPO_PUBLIC_GUMROAD_PRODUCT_ID=xxxxxxxxxxxxxxxxxxxxxx==
EXPO_PUBLIC_GUMROAD_URL=https://ton-pseudo.gumroad.com/l/bucheur

# App Store / Google Play : clés publiques RevenueCat (Project settings › API keys).
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxx
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxx

# Sans aucune clé, l'achat est simulé en développement et toutes les fonctions Pro
# sont offertes dans la version publiée.
